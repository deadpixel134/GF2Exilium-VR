<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>GF2VR.Installer</AssemblyName>
    <Version>0.3.0</Version>
    <OutputPath>../../build/installer/bin/</OutputPath>
  </PropertyGroup>
  <Import Project="../../tools/variant_metadata.props" />
  <ItemGroup Condition="'$(GF2VRVariantMetadataRoot)' != ''">
    <Compile Remove="VariantProfiles.generated.cs" />
    <Compile Include="$(GF2VRVariantProfilesFile)" Link="VariantProfiles.generated.cs" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Locales/*.json" /></ItemGroup>
</Project>
