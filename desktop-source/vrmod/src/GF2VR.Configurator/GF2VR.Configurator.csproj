<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GF2VR.Configurator</AssemblyName>
    <Version>0.1.0</Version>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>../../build/settings/bin/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GF2VRBuildFlavor)' == 'Dirty'">
    <DefineConstants>$(DefineConstants);GF2VR_TOUCH_PRIVATE;GF2VR_DIRTY_CONTACT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GF2VRBuildFlavor)' == 'Dirty'">
    <Compile Include="../../../../native-source/variants/managed/dirty/ContactConfig.cs;../../../../native-source/variants/managed/dirty/ContactMaterial.cs" Link="Contact/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Locales/Dirty/*.json" />
  </ItemGroup>
  <Import Project="../../tools/variant_metadata.props" />
  <ItemGroup>
    <Compile Include="../GF2VR.Installer/VariantProfiles.generated.cs" Link="InstallerUpdate/VariantProfiles.generated.cs" Condition="'$(GF2VRVariantMetadataRoot)' == ''" />
    <Compile Include="$(GF2VRVariantProfilesFile)" Link="InstallerUpdate/VariantProfiles.generated.cs" Condition="'$(GF2VRVariantMetadataRoot)' != ''" />
    <EmbeddedResource Include="Locales/*.json" />
    <Content Include="runtime-contract.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(GF2VRVariantMetadataRoot)' == ''" />
    <Content Include="$(GF2VRVariantRuntimeContract)" Link="runtime-contract.json" TargetPath="runtime-contract.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(GF2VRVariantMetadataRoot)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <!-- Installer owns update policy/transaction code; Settings consumes only
         the startup/consent surface. No duplicate file replacement engine. -->
    <Compile Include="../GF2VR.Installer/Contracts.cs;../GF2VR.Installer/Paths.cs;../GF2VR.Installer/NativeLayout.cs;../GF2VR.Installer/InstallationEngine.cs;../GF2VR.Installer/UpdatePolicy.cs;../GF2VR.Installer/GithubOwnerClient.cs;../GF2VR.Installer/UpdateStaging.cs;../GF2VR.Installer/UpdateService.cs" Link="InstallerUpdate/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
